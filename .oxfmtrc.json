{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "ignorePatterns": [
    "_legacy/**",
    "public/**",
    ".claude/**",
    ".agents/**",
    "**/*.md",
    "app/assets/json/**",
    "pnpm-lock.yaml",
    "app/assets/sass/foundation/mixin/_animation.scss",
    "**/*.toml"
  ]
}
